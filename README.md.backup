│
├── geojsons/                   # Dados geoespaciais
│   ├── ciclovia.geojson       # Infraestrutura cicloviária
│   ├── estacoes.geojson       # Localização das estações
│   └── hotzones.geojson       # Zonas de alta demanda
│
├── analises_monografia/        # Análises para TCC
│   ├── 01_verificar_dados.py
│   ├── 02_analise_temporal.py
│   ├── 03_analise_por_estacao.py
│   ├── 04_analise_fluxos.py
│   ├── 05_gerar_relatorio.py
│   ├── executar_todas_analises.sh
│   └── resultados/
│       ├── graficos/          # Gráficos PNG (300 DPI)
│       ├── *.csv              # Dados estatísticos
│       └── estatisticas_monografia.tex    # Comandos LaTeX
│
└── docs/                       # Documentação
    ├── GUIA_PROCESSAMENTO_DADOS.md
    ├── DOCKER_SETUP.md
    └── DOCKER_USAGE.md
```

